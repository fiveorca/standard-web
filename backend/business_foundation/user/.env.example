# 用户中心环境变量示例（复制为 .env 后按需修改）。

# HTTP
USER_PORT=8081
CORS=http://localhost:3000,http://localhost:8080
USER_TRUST_PROXY=true

# PostgreSQL（Flyway 启动时自动执行 src/main/resources/db/migration）
USER_DATABASE_URL=jdbc:postgresql://localhost:5432/user_center
USER_DATABASE_USER=user_center
USER_DATABASE_PASSWORD=user_center
USER_DB_POOL_SIZE=10
USER_FLYWAY_ENABLED=true

# Redis（可选：连接失败时自动降级为进程内缓存与限流）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 认证中心
USER_AUTH_BASE_URL=http://localhost:8080
USER_JWKS_URL=http://localhost:8080/oauth2/jwks
USER_AUTH_ISSUER=
USER_AUTH_AUDIENCE=
USER_AUTH_TIMEOUT_SECONDS=5
USER_JWKS_CACHE_SECONDS=300

# 内部服务令牌（必须与认证中心 security.internal_token 完全一致）
USER_INTERNAL_TOKEN=dev-internal-token-change-me-0001
USER_EVENTS_TARGET=http://localhost:8080/api/v1/internal/events

# 注册
USER_REGISTRATION_ENABLED=true
USER_REGISTRATION_REQUIRE_REVIEW=true
USER_REGISTRATION_RATE_LIMIT=10

# 批量导入/更新上限
USER_BATCH_MAX_ITEMS=500
