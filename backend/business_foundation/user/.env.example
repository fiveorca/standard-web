# 用户中心环境变量示例（复制为 .env 后按需修改）。

USER__SERVER__BIND=0.0.0.0:8081
USER__SERVER__PUBLIC_BASE_URL=http://localhost:8081
USER__SERVER__CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

USER__DATABASE__URL=postgres://user_center:user_center@localhost:5432/user_center
USER__DATABASE__AUTO_MIGRATE=true

USER__REDIS__URL=redis://localhost:6379/1
USER__REDIS__REQUIRED=false

# 必须与认证中心 security.internal_token 完全一致
USER__AUTH__BASE_URL=http://localhost:8080
USER__AUTH__INTERNAL_TOKEN=dev-internal-token-change-me-0001
USER__AUTH__SERVICE_CLIENT_ID=user-center
USER__AUTH__SERVICE_CLIENT_SECRET=
USER__AUTH__JWKS_CACHE_SECS=300

USER__LOGGING__LEVEL=info
USER__LOGGING__FORMAT=json

USER__REGISTRATION__ENABLED=true
USER__REGISTRATION__REQUIRE_REVIEW=false
USER__REGISTRATION__RATE_LIMIT_PER_MINUTE=10
