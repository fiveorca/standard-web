# im-service 环境变量示例。
# 使用方式：cp .env.example .env，然后按环境修改敏感值。
# 生产环境请勿提交 .env，也不要沿用任何默认密钥。

# ---------------------------------------------------------------------------
# PostgreSQL（docker compose 使用）
# ---------------------------------------------------------------------------
POSTGRES_DB=im
POSTGRES_USER=im
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# 直接以 jar 运行时使用（docker compose 内由 SPRING_DATASOURCE_URL 覆盖）
IM_DATABASE_URL=jdbc:postgresql://localhost:5432/im
IM_DATABASE_USER=im
IM_DATABASE_PASSWORD=change-me-strong-password
IM_DB_POOL_SIZE=20

# ---------------------------------------------------------------------------
# HTTP / gRPC
# ---------------------------------------------------------------------------
IM_HTTP_PORT=8080
IM_GRPC_PORT=9090
IM_GRPC_ENABLED=true
IM_GRPC_AUTH_ENABLED=true

# gRPC TLS / mTLS（生产建议开启）
IM_GRPC_TLS_ENABLED=false
IM_GRPC_REQUIRE_CLIENT_AUTH=false
IM_GRPC_CERT_CHAIN=
IM_GRPC_PRIVATE_KEY=
IM_GRPC_TRUST_CERT=

# ---------------------------------------------------------------------------
# 安全（必须修改）
# ---------------------------------------------------------------------------
# AES-256-GCM 主密钥：Base64 编码的 32 字节；可用
#   openssl rand -base64 32
# 生成。修改后历史密文将无法解密，请通过密钥轮换流程处理。
IM_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# 管理 API 快捷密钥（X-API-Key），仅建议在受控内网或本地使用
IM_ADMIN_API_KEY=dev-admin-key-change-me

# 内部服务令牌：EMQX HTTP 回调、gRPC 内部调用
IM_INTERNAL_TOKEN=dev-internal-token-change-me

# 设备令牌摘要 pepper，修改后已签发设备令牌全部失效
IM_DEVICE_TOKEN_PEPPER=dev-device-pepper-change-me

IM_SECURITY_ENABLED=true
IM_ADMIN_ROLE=IM_ADMIN
IM_SERVICE_ROLE=IM_SERVICE

# 平台 JWT 校验（三选一：HMAC 密钥或 JWKS 地址；issuer/audience 可选）
IM_JWT_HMAC_SECRET=
IM_JWT_JWKS_URL=
IM_JWT_ISSUER=
IM_JWT_AUDIENCE=
IM_JWT_ROLES_CLAIM=roles
IM_JWT_TENANT_CLAIM=tenant_id
IM_JWT_CLOCK_SKEW_SECONDS=30

# HTTP / gRPC 限流（每分钟）
IM_RATE_LIMIT_ENABLED=true
IM_RATE_LIMIT_HTTP_PER_MINUTE=600
IM_RATE_LIMIT_GRPC_PER_MINUTE=6000

# ---------------------------------------------------------------------------
# MQTT / EMQX
# ---------------------------------------------------------------------------
EMQX_MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change-me

IM_MQTT_CLIENT_ID_PREFIX=im-service-publisher
IM_MQTT_DEFAULT_QOS=1
IM_MQTT_MAX_PAYLOAD_BYTES=262144
IM_MQTT_PUBLISH_TIMEOUT_SECONDS=10
IM_MQTT_STATUS_CHECK_INTERVAL_MS=30000
IM_MQTT_SERVICE_TOPIC_PREFIX=tenants/

# 首次启动初始化默认 Broker / 接入配置
IM_SEED_ENABLED=true
IM_SEED_BROKER_CODE=emqx-default
IM_SEED_BROKER_HOST=localhost
IM_SEED_BROKER_TCP_PORT=1883
IM_SEED_BROKER_TLS_ENABLED=false
IM_SEED_ACCESS_CONFIG_CODE=default
IM_SEED_TENANT_ID=
IM_SEED_SERVICE_TOPIC_PREFIX=tenants/

# 注意：docker/emqx/emqx.conf 中的 X-Internal-Token 必须与 IM_INTERNAL_TOKEN 一致。
# 修改 IM_INTERNAL_TOKEN 后需同步修改该文件并重启 emqx。

# ---------------------------------------------------------------------------
# 邮件
# ---------------------------------------------------------------------------
IM_EMAIL_WORKER_ENABLED=true
IM_EMAIL_POLL_INTERVAL_MS=2000
IM_EMAIL_BATCH_SIZE=20
IM_EMAIL_MAX_ATTEMPTS=5
IM_EMAIL_RETRY_BASE_SECONDS=60
IM_EMAIL_RETRY_MAX_SECONDS=3600
IM_EMAIL_LOCK_TIMEOUT_SECONDS=900
IM_EMAIL_ATTACHMENT_DIR=./data/email-attachments
IM_EMAIL_MAX_ATTACHMENT_BYTES=10485760
IM_EMAIL_MAX_TOTAL_ATTACHMENT_BYTES=26214400
IM_EMAIL_ALLOWED_ATTACHMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,json,xml,zip,gz,png,jpg,jpeg,gif,webp
IM_EMAIL_MAX_RECIPIENTS=100
IM_EMAIL_RATE_LIMIT_ENABLED=true
IM_EMAIL_WORKER_ID=

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
IM_CORS=*
IM_FLYWAY_ENABLED=true
