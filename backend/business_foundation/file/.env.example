# 文件服务环境变量示例（复制为 .env 后按需修改，禁止提交真实密钥）。

# HTTP
FILE_PORT=8082
FILE_PUBLIC_BASE_URL=http://localhost:8082
CORS=*
FILE_TRUST_PROXY=true

# 接口认证（为空表示开发模式不校验）
FILE_API_KEY=dev-file-api-key-change-me

# PostgreSQL（Flyway 启动时自动执行 src/main/resources/db/migration）
FILE_DATABASE_URL=jdbc:postgresql://localhost:5432/file_service
FILE_DATABASE_USER=file_service
FILE_DATABASE_PASSWORD=file_service
FILE_DB_POOL_SIZE=16
FILE_FLYWAY_ENABLED=true

# 本地存储
FILE_LOCAL_ROOT=./data/storage
FILE_UPLOAD_WORK_DIR=./data/upload-tmp
FILE_MAX_FILE_SIZE=5368709120
FILE_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,bmp,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,json,xml,zip,gz,mp4,webm,mp3,ogg,wav
FILE_ALLOWED_MIME_TYPES=image/*,application/pdf,text/*,application/json,application/xml,application/zip,application/gzip,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.*,video/mp4,video/webm,audio/*
FILE_SNIFF_CONTENT=true

# 上传与下载
FILE_UPLOAD_EXPIRY_SECONDS=3600
FILE_UPLOAD_MIN_PART_SIZE=5242880
FILE_UPLOAD_MAX_PART_SIZE=104857600
FILE_UPLOAD_MAX_PARTS=1000
FILE_CONFIRM_TIMEOUT_MINUTES=30
FILE_DOWNLOAD_URL_TTL=300
FILE_DOWNLOAD_SECRET=

# 清理任务
FILE_CLEANUP_ENABLED=true
FILE_CLEANUP_DRY_RUN=false
FILE_ORPHAN_SAFETY_MINUTES=1440
FILE_DELETE_GRACE_MINUTES=10
FILE_CLEANUP_BATCH_SIZE=200
FILE_CLEANUP_MAX_PER_RUN=1000

# 密钥
# 32 字节 Base64 密钥，用于 AES-GCM 加密存储凭据；生产环境必须替换。
FILE_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# 初始化默认 LOCAL 存储
FILE_SEED_ENABLED=true
FILE_SEED_LOCAL_CODE=local-default
