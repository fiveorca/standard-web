# 认证授权中心环境变量示例（复制为 .env 后按需修改）。

AUTH_PORT=8080
AUTH_ISSUER=http://localhost:8080
AUTH_BASE_URL=http://localhost:8080
AUTH_CORS_ORIGINS=*

AUTH_DATABASE_URL=jdbc:postgresql://localhost:5432/auth_center
AUTH_DATABASE_USER=postgres
AUTH_DATABASE_PASSWORD=postgres
AUTH_DB_POOL_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 用于加密签名私钥、客户端密钥等敏感数据；生产环境必须替换
AUTH_ENCRYPTION_KEY=dev-encryption-key-change-me-32bytes
AUTH_INTERNAL_TOKEN=dev-internal-token-change-me
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

AUTH_REGISTRATION_ENABLED=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
AUTH_ID_TOKEN_TTL=900
AUTH_SESSION_TTL=604800
AUTH_CODE_TTL=300
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_OTP_TTL=300

AUTH_EVENTS_TARGET=http://localhost:8081/api/v1/internal/events
USER_SERVICE_URL=http://localhost:8081
AUTH_NOTIFICATION_WEBHOOK=

AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_NAME=Auth Center
AUTH_WEBAUTHN_ORIGIN=http://localhost:8080

# 首次启动引导（幂等）
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
AUTH_BOOTSTRAP_CLIENT_SECRET=dev-client-secret-change-me
