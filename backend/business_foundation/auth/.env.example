# 认证授权中心环境变量示例（复制为 .env 后按需修改）。

AUTH__SERVER__BIND=0.0.0.0:8080
AUTH__SERVER__PUBLIC_BASE_URL=http://localhost:8080
AUTH__SERVER__CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

AUTH__DATABASE__URL=postgres://auth_center:auth_center@localhost:5432/auth_center
AUTH__DATABASE__AUTO_MIGRATE=true

AUTH__REDIS__URL=redis://localhost:6379/0
AUTH__REDIS__REQUIRED=true

# 32 字节 Base64 编码；生成方式：openssl rand -base64 32
AUTH__SECURITY__MASTER_KEY=3geuNbeEwCC5OwBz78oo3fbuecUVKlNa4NmP1beftWQ=
AUTH__SECURITY__INTERNAL_TOKEN=dev-internal-token-change-me-0001
AUTH__SECURITY__COOKIE_SECURE=false
AUTH__SECURITY__ALLOWED_REDIRECT_ORIGINS=["http://localhost:3000"]

AUTH__NOTIFICATIONS__PROVIDER=log
AUTH__EVENTS__PUBLISH_URLS=["http://localhost:8081/api/v1/internal/events"]
AUTH__EVENTS__SERVICE_TOKEN=dev-internal-token-change-me-0001
AUTH__EVENTS__ALLOW_HTTP_TARGETS=true

AUTH__LOGGING__LEVEL=info
AUTH__LOGGING__FORMAT=json

# 首次启动的管理员账号（未设置密码时会随机生成并打印到日志）
AUTH_SEED_ADMIN_USERNAME=admin
AUTH_SEED_ADMIN_EMAIL=admin@example.com
AUTH_SEED_ADMIN_PASSWORD=
# 用户中心服务客户端密钥；未设置时随机生成并打印日志
AUTH_SEED_USER_CENTER_SECRET=
